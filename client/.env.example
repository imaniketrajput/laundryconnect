# Client Environment Configuration
# When running locally in dev mode (npm run dev), LaundryConnect automatically defaults to http://localhost:5000/api
# You can override with custom values below if desired:
# VITE_API_URL=http://localhost:5000/api
# VITE_SOCKET_URL=http://localhost:5000

# Google OAuth 2.0 Client ID (Matches GOOGLE_CLIENT_ID on server)
# Safe to expose client-side per OAuth 2.0 web client specification
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
