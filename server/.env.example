PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/laundryconnect?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:5173

# Razorpay API Credentials (Test Mode)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

# Gmail SMTP Credentials for Transactional Emails (Nodemailer)
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Service Area Geofencing Configuration (Facility Coordinates & Service Radius in KM)
HUB_LAT=12.9716
HUB_LNG=77.5946
SERVICE_RADIUS_KM=15

# Google Gemini AI Chatbot Configuration (Read ONLY via process.env on server; never expose to client)
# Get your free API key at https://aistudio.google.com/apikey (free, no card required)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Google OAuth 2.0 Client ID (Required for Google Sign-In / Sign-Up)
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web Application)
# Add Authorized JavaScript origins: http://localhost:5173, https://your-app.vercel.app
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
